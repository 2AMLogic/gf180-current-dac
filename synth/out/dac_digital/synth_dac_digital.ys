# Commit-safe form (issue #1870): the liberty below is written relative
# to $PDK_ROOT, which Yosys does NOT expand -- this file is the artifact
# to commit, not the one to run. Run the rehydrated sibling
# 'synth_dac_digital.run.ys' (regenerated by every `klt synthesize` run), or
# substitute your own PDK install root for $PDK_ROOT first.
read_verilog rtl/thermo_decoder.v
read_verilog rtl/dac_digital.v
hierarchy -check -top dac_digital
synth -top dac_digital
dfflibmap -liberty $PDK_ROOT/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib
tee -q -o synth/out/dac_digital/dac_digital_abc.log abc -liberty $PDK_ROOT/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib -constr synth/out/dac_digital/dac_digital_abc.constr
clean
setundef -zero
hilomap -hicell gf180mcu_fd_sc_mcu7t5v0__tieh Z -locell gf180mcu_fd_sc_mcu7t5v0__tiel ZN
tee -q -o synth/out/dac_digital/dac_digital_stats.json stat -liberty $PDK_ROOT/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_3v30.lib -json -top dac_digital
write_verilog -noattr synth/out/dac_digital/dac_digital_synth.v
